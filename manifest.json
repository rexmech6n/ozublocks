{
  "manifest_version": 3,
  "name": "OzUBlocks",
  "version": "1.0.0",
  "description": "Turn every class into a calendar block.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://sis.ozyegin.edu.tr/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OzUBlocks",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}